---
import Model from './Model.astro';

export interface Model {
    id: number;
    name: string;
    public_url: string;
    thumbnail: string;
    preview_image: string;
}

const thingiverseApi = 'https://api.thingiverse.com/users/Gateway3/things';
let models: Model[] = [];
if (import.meta.env.THINGIVERSE_API_TOKEN) {
    try {
        const response = await fetch(thingiverseApi, {
            headers: { Authorization: import.meta.env.THINGIVERSE_API_TOKEN },
            signal: AbortSignal.timeout(15000)
        });
        if (response.ok) {
            const data = await response.json();
            if (Array.isArray(data)) models = data;
        }
    } catch {
        console.warn('Thingiverse models are unavailable for this build.');
    }
}
---
<section>
    <div>
        {
            models.map(model => (
                <Model params={model}/>
            ))
        }
    </div>
</section>

<style>
    div {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
    }
    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-right: .5rem;
        margin-left: .5rem;
    }
</style>
